digraph ml1_map {
    rankdir=LR;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="ML1(Ch02~15) 개념 지도 — 하나의 큰 질문: '무엇을 데이터로 갖고, 무엇을 맞히고 싶은가?'",
           labeljust=c, bgcolor="white"];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=11,
           penwidth=1.3, margin="0.15,0.08"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9.5, color="#495057", penwidth=1.5];

    subgraph cluster_data {
        label="1. 데이터와 문제 정의";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fillcolor="#e9ecef", fontsize=10];
        D1 [label="행(row)은 무엇인가?\n(환자? 이미지? 토큰?)"];
        D2 [label="정답이 있는가?\n지도·비지도·생성"];
        D3 [label="데이터의 형태\n정형·이미지·시퀀스·그래프"];
        D4 [label="베이스레이트\n(다수 클래스 모델)"];
        D1 -> D2 -> D3 -> D4 [style=invis];
    }

    subgraph cluster_model {
        label="2. 모델: 무엇을 어떻게 '맞히게'するか (Ch02~15)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fontsize=9.5];
        M1 [label="선형·판별적\n로지스틱회귀·SVM (Ch02,05)"];
        M2 [label="생성적(분류)\nGDA·나이브베이즈 (Ch03)"];
        M3 [label="거리 기반\nkNN·k-means·GMM (Ch04)"];
        M4 [label="트리/앙상블\nRF·GBDT·SHAP (Ch07)"];
        M5 [label="신경망 + 역전파\n(Ch09)"];
        M6 [label="CNN (Ch10)"];
        M7 [label="RNN (Ch11)"];
        M8 [label="어텐션·Transformer\n(Ch12)"];
        M8g [label="그래프 표현학습\nRandom Walk·Node2Vec (Ch13)"];
        M9 [label="비지도: PCA·word2vec·임베딩\n(Ch14)"];
        M10 [label="잠재변수 생성\nVAE·GAN·Diffusion (Ch15)"];
        M1 -> M2 -> M3 -> M4 -> M5 -> M6 -> M7 -> M8 -> M8g -> M9 -> M10 [style=invis];
    }

    subgraph cluster_learn {
        label="3. 학습: 거의 모든 장에서 반복되는 구조";
        labeljust=l; fontsize=12; fontcolor="#0f5132";
        color="#79bb98"; style="rounded,filled"; fillcolor="#f0f7f3";
        node [fillcolor="#d1e7dd", fontsize=10];
        L1 [label="① 모델을 정의한다\n(파라미터 θ)"];
        L2 [label="② 틀린 정도를 손실함수로\n수치화한다 (Ch02~15)"];
        L3 [label="③ 그 손실을 줄이는 방향으로\nθ를 조정한다 (경사하강·역전파)"];
        L4 [label="④ 과적합 통제: 정규화·CV\n(Ch06) — 두 목표의 균형"];
        L1 -> L2 -> L3 -> L4 [style=invis];
    }

    subgraph cluster_eval {
        label="4. 평가: 정직한 숫자 하나";
        labeljust=l; fontsize=12; fontcolor="#0f5132";
        color="#79bb98"; style="rounded,filled"; fillcolor="#f0f7f3";
        node [fillcolor="#d1e7dd", fontsize=10];
        E1 [label="train/val/test 3분할\n전처리도 train으로만 fit\n(Ch06.3, 누수 금지)"];
        E2 [label="하이퍼파라미터는\nval/교차검증에서만 (Ch06.2)"];
        E3 [label="test는 딱 한 번\n베이스라인과 비교\n(Ch02.3, Ch06.3)"];
        E1 -> E2 -> E3 [style=invis];
    }

    ML2 [label="ML2로: 정답 대신 보상만\n— 강화학습, 로봇 시뮬레이션\n(에이전트가 스스로 데이터를 만듦)",
         fillcolor="#fff3cd", fontsize=10, penwidth=2.0];

    D3 -> M1 [label="데이터 형태가\n도구 골격을 정함"];
    M4 -> L1 [label="각 모델엔\n자신만의 손실·경사"];
    M10 -> L2 [label="생성: ELBO·min-max\n(Ch15)"];
    L4 -> E1 [label="val로만 판단,\ntest는 한 번"];
    E3 -> D1 [label="과적합·누수면\n돌아가서 다시",
               style=dashed, color="#c0392b", penwidth=1.8];
    L3 -> ML2 [label="정답 y가 사라지면\n손실→'보상'으로, 데이터→'에이전트의 경험'\n— 같은 구조, 다른 질문",
               color="#b8860b", penwidth=2.2, style=dashed];
}
