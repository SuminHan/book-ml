digraph project_pipeline {
    rankdir=LR;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="팀 프로젝트 파이프라인 — 4주: 데이터 선정 → 발표 (Block A 캡스톤)",
           labeljust=c, bgcolor="white"];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=10.5,
           penwidth=1.3, margin="0.18,0.1"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9, color="#495057", penwidth=1.5];

    subgraph cluster_p1 {
        label="① 데이터와 문제 (1주차)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fillcolor="#e9ecef", fontsize=10];
        N1 [label="정형 데이터 고르기\n(Kaggle / UCI)"];
        N2 [label="문제 정의:\n무엇을, 어떤 라벨로\n예측하는가"];
        N3 [label="베이스라인 설정:\n다수 클래스 모델\n(Ch02.3)"];
        N1 -> N2 -> N3 [style=invis];
    }

    subgraph cluster_p2 {
        label="② 파이프라인 (2~3주차)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fontsize=10];
        N4 [label="train/val/test 3분할\n(Ch06.3 — test는 한 번만)"];
        N5 [label="전처리:\n스케일링·결측치\ntrain으로만 fit"];
        N6 [label="Ch02~07에서\n모델 ≥ 2개 적용\n(예: 로지스틱회귀+GBDT)"];
        N7 [label="하이퍼파라미터 튜닝:\nval/교차검증만 사용\n(Ch06.2)"];
        N4 -> N5 -> N6 -> N7 [style=invis];
    }

    subgraph cluster_p3 {
        label="③ 평가와 정당화 (3~4주차)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fontsize=10];
        N8 [label="test 최종 측정 — 딱 한 번\n(accuracy · F1 · PR-AUC)"];
        N9 [label="수식적 정당화 ≥ 1개:\n배운 개념으로\n'왜' 설명 (Ch02~07)"];
        N10 [label="보고서: 결과 +\n잘 안 된 부분의 원인\n정직하게"];
        N8 -> N9 -> N10 [style=invis];
    }

    subgraph cluster_p4 {
        label="④ 발표와 검토 (4주차)";
        labeljust=l; fontsize=12; fontcolor="#0f5132";
        color="#79bb98"; style="rounded,filled"; fillcolor="#f0f7f3";
        node [fillcolor="#d1e7dd", fontsize=10];
        N11 [label="발표 5~7분\n(8.1)"];
        N12 [label="peer-review 2팀\n(8.2 체크리스트)"];
        N11 -> N12 [style=invis];
    }

    N3 -> N4 [label="문제 고정"];
    N7 -> N8 [label="최종 모델 확정"];
    N10 -> N11 [label="보고서"];
    N8 -> N4 [label="누수·과적합 발견 시\n돌아가서 다시",
               style=dashed, color="#c0392b", penwidth=1.8];
}
