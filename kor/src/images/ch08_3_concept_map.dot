digraph blockA_map {
    rankdir=LR;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="Block A(Ch02~07) 개념 지도 — 하나의 큰 질문: '이 데이터에 어떤 도구가 맞는가?'",
           labeljust=c, bgcolor="white"];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=11,
           penwidth=1.3, margin="0.15,0.08"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9.5, color="#495057", penwidth=1.5];

    subgraph cluster_data {
        label="1. 데이터와 문제 정의";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fillcolor="#e9ecef", fontsize=10];
        D1 [label="행(row)은 무엇인가?\n(환자? 거래? 고객?)"];
        D2 [label="베이스레이트\n(다수 클래스 모델의\n정확도)"];
        D3 [label="train/val/test 분할\n(Ch06.3)"];
        D1 -> D2 -> D3 [style=invis];
    }

    subgraph cluster_model {
        label="2. 모델 고르기 (Ch02~07)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fontsize=10];
        M1 [label="선형\n로지스틱회귀 · Ridge\n(Ch02, 06)"];
        M2 [label="생성적\nGDA · 나이브베이즈\n(Ch03)"];
        M3 [label="거리\nkNN\n(Ch04)"];
        M4 [label="마진\nSVM · 커널\n(Ch05)"];
        M5 [label="트리 / 앙상블\nRF · GBDT\n(Ch07)"];
        M1 -> M2 -> M3 -> M4 -> M5 [style=invis];
    }

    subgraph cluster_obj {
        label="3. 학습: 목적함수 + 알고리즘";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fontsize=10];
        O1 [label="손실함수\nMSE · 교차엔트로피 ·\n힌지 · 지니 (Ch02~07)"];
        O2 [label="+ λ × (가중치 크기)\n정규화 (Ch06)"];
        O3 [label="경사하강 · 정규방정식\n트리 분할(탐욕적, Ch07.1)"];
        O1 -> O2 -> O3 [style=invis];
    }

    subgraph cluster_eval {
        label="4. 평가: 정직한 숫자 하나";
        labeljust=l; fontsize=12; fontcolor="#0f5132";
        color="#79bb98"; style="rounded,filled"; fillcolor="#f0f7f3";
        node [fillcolor="#d1e7dd", fontsize=10];
        E1 [label="하이퍼파라미터는\nval에서만 (CV, Ch06.2)"];
        E2 [label="test는 딱 한 번\n(정확도 · PR-AUC, Ch02.3)"];
        E1 -> E2 [style=invis];
    }

    D3 -> M1 [label="데이터 특성에\n맞아 도구 고르기"];
    M5 -> O1 [label="각 모델엔\n자신만의 목적함수"];
    O3 -> E1 [label="train으로만 fit\n(누수 금지, Ch06.3)"];
    E2 -> D1 [label="과적합이면 돌아가기\n(모델·λ·데이터 변경)",
                 style=dashed, color="#c0392b", penwidth=1.8];
}
