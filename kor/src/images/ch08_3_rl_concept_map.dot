digraph blockA_rl_map {
    rankdir=TB;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="Block A(Ch02~07) 개념 지도 — 한 질문에 여섯 각도의 답",
           labeljust=c, bgcolor="white"];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=10.5,
           penwidth=1.3, margin="0.18,0.1"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9, color="#495057", penwidth=1.5];

    Q [label="한 개의 큰 질문:\n'미래의 불확실한 보상을 지금 어떻게\n수치화할 것인가?' (V* 와 Q*를 찾는 것)",
        fillcolor="#fff8e1", fontcolor="#7a4f00", penwidth=2, fontsize=11.5];

    subgraph cluster_form {
        label="1. 문제를 수학적으로 쓰기 (Ch02~03)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fillcolor="#e9ecef", fontsize=10];
        B1 [label="밴딧 (Ch02)\n상태 1개의 특수 MDP\n탐험-활용 딜레마가 처음 등장"];
        B2 [label="MDP 5요소 (Ch03)\nS, A, P, R, γ · 마르코프 성질"];
        B3 [label="리턴과 할인율 γ (Ch03)\nG_t = R + γR' + γ²R'' + …\nγ < 1: 무한 호라이즌에서\n합이 유한하도록 + 축소 계수"];
        B1 -> B2 -> B3;
    }

    subgraph cluster_path {
        label="2. 가치를 찾는 경로 (Ch04~07)";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fontsize=10];
        A1 [label="벨만방정식 (Ch04)\nV = R + γ·V' (정책)\n+ max → 최적방정식",
             fillcolor="#dbeafe"];
        A2 [label="정책반복 / 가치반복 (Ch04)\n모델을 알 때: T를 반복 대입해\n고정점 V*에 수렴 (축소 사상)",
             fillcolor="#dbeafe"];
        A3 [label="MC (Ch05)\n모델을 몰라도: 에피소드 리턴\nG_t로 추정 (첫방문, MC 제어,\n중요도 샘플링)",
             fillcolor="#d1e7dd"];
        A4 [label="TD 학습 (Ch06)\n에피소드가 끝나기를 기다리지 않고:\nTD 오차 δ = 목표값 − Q\nSARSA (on) vs Q-learning (off)",
             fillcolor="#d1e7dd"];
        A5 [label="n-step · 적격흔적 · Dyna-Q (Ch07)\n편향-분산의 다이얼 n, λ\n경험을 모델로 저장해 재사용",
             fillcolor="#d1e7dd"];
        A1 -> A2;
        A3 -> A4 -> A5;
    }

    subgraph cluster_axes {
        label="3. 모든 경로를 가로지르는 4개의 축";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fillcolor="#e9ecef", fontsize=9.5];
        X1 [label="편향-분산\n(정확성 대 흔들림)\nMC ↔ TD(0)의 스펙트럼"];
        X2 [label="탐험\nε-greedy · 낙관적\n초기화 · UCB"];
        X3 [label="수렴\n목표값 오차→0,\nα를 작게, 무한 방문"];
        X4 [label="on / off-policy\n(행동 정책\nvs 목표 정책)"];
        X1 -> X2 -> X3 -> X4 [style=invis];
    }

    BB [label="Block B (Ch09~16)\n표 → 신경망: DQN · 정책그라디언트 · 로봇",
        fillcolor="#f3e5f5", fontcolor="#4a2d5e", penwidth=1.8];

    Q -> B1;
    Q -> A1 [label="모델이 있으면"];
    Q -> A3 [label="모델이 없으면"];
    B3 -> A1 [label="재귀 구조"];
    B3 -> A3 [label="경험"];
    A2 -> BB [label="가치 기반의\n완결", style=bold, color="#7048a8"];
    A5 -> BB [label="Q표를\n신경망으로 (DQN)", style=bold, color="#7048a8", penwidth=2];
    A3 -> X2 [style=dashed, color="#90a4ae"];
    A4 -> X2 [style=dashed, color="#90a4ae"];
    A4 -> X1 [label="n이 다이얼 (Ch07)", style=dashed, color="#90a4ae"];
    A5 -> X1 [style=dashed, color="#90a4ae"];
    A2 -> X3 [label="축소 사상", style=dashed, color="#90a4ae"];
    A4 -> X3 [label="α·방문 조건", style=dashed, color="#90a4ae"];
    A4 -> X4 [label="max 한 줄의 차이", style=dashed, color="#90a4ae"];
    A3 -> X4 [label="중요도 샘플링", style=dashed, color="#90a4ae"];
}
