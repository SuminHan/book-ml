digraph rnn_unroll {
    rankdir=LR;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="RNN을 시간 축 3칸(시점 t=1,2,3)만큼 펼쳐(unroll) 그린 계산도 — 각 시점에서 \"동일한\" W_xh, W_hh, b_h가 재사용된다(파라미터 공유). self-loop가 \"기억\"이다",
           labeljust=c, bgcolor="white", pad=0.3];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=10,
           penwidth=1.3, margin="0.18,0.1"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9, color="#495057", penwidth=1.5];

    subgraph cluster_x {
        label="입력 x_t (one-hot)"; labeljust=l; fontsize=11;
        fontcolor="#343a40"; color="#adb5bd"; style="rounded,filled";
        fillcolor="#f8f9fa";
        node [fillcolor="#e7f1ff"];
        X1 [label="x_1 (단어 1)"];
        X2 [label="x_2 (단어 2)"];
        X3 [label="x_3 (단어 3)"];
    }

    subgraph cluster_h {
        label="은닉 상태 h_t (매 시점 갱신되는 \"요약\")"; labeljust=l;
        fontsize=11; fontcolor="#343a40"; color="#adb5bd";
        style="rounded,filled"; fillcolor="#fff9db";
        node [fillcolor="#fff3bf"];
        H0 [label="h_0 = 0\n(초기 상태)", fillcolor="#e9ecef"];
        H1 [label="h_1 = tanh(W_xh x_1 + W_hh h_0 + b_h)"];
        H2 [label="h_2 = tanh(W_xh x_2 + W_hh h_1 + b_h)"];
        H3 [label="h_3 = tanh(W_xh x_3 + W_hh h_2 + b_h)"];
    }

    subgraph cluster_y {
        label="출력 y_t = W_hy h_t + b_y"; labeljust=l; fontsize=11;
        fontcolor="#343a40"; color="#adb5bd"; style="rounded,filled";
        fillcolor="#f8f9fa";
        node [fillcolor="#d3f9d8"];
        Y1 [label="y_1"];
        Y2 [label="y_2"];
        Y3 [label="y_3"];
    }

    # 같은 시점의 세 노드를 세로로 묶기 (rank 제약)
    X1 -> H1 [style=invis];
    X2 -> H2 [style=invis];
    X3 -> H3 [style=invis];
    H1 -> Y1 [style=invis];
    H2 -> Y2 [style=invis];
    H3 -> Y3 [style=invis];

    # 입력 -> 은닉 (매 시점 \"같은\" W_xh)
    X1 -> H1 [label="W_xh"];
    X2 -> H2 [label="W_xh"];
    X3 -> H3 [label="W_xh"];

    # 이전 은닉 상태 -> 다음 은닉 상태 (매 시점 \"같은\" W_hh)
    H0 -> H1 [label="W_hh", color="#e8590c"];
    H1 -> H2 [label="W_hh", color="#e8590c"];
    H2 -> H3 [label="W_hh", color="#e8590c"];

    # self-loop: \"지금까지의 요약\"을 다음 시점으로 반납
    H1 -> H1 [label="기억\n(자신)", color="#e8590c"];
    H2 -> H2 [label="기억\n(자신)", color="#e8590c"];
    H3 -> H3 [label="기억\n(자신)", color="#e8590c"];

    # 은닉 -> 출력 (매 시점 \"같은\" W_hy)
    H1 -> Y1 [label="W_hy"];
    H2 -> Y2 [label="W_hy"];
    H3 -> Y3 [label="W_hy"];

    NOTE [label="h_3는 x_1, x_2, x_3 \"모두\"에서 온다.\n(과거 전체의 함수) 반대로 h_1는 x_1에서만 온다.",
          shape=note, fillcolor="#fff3cd", fontsize=9];
    Y3 -> NOTE [style=dashed, color="#868e96"];
}
