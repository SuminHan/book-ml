digraph ch12_1_qkv {
    rankdir=TB;
    graph [fontname="Noto Sans CJK KR", bgcolor="white", pad=0.25,
           ranksep=0.75, nodesep=0.5];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           penwidth=1.4, fontsize=13, margin="0.18,0.1"];
    edge  [penwidth=1.6, arrowsize=0.8];

    X [label="입력 X (단어 임베딩)\nx1 = (1, 0),  x2 = (0, 1)",
         fillcolor="#f0f0f0", color="#666666", fontsize=14];

    WQ [label="W_Q  (학습 행렬)", fillcolor="#dae8fc", color="#4878a8"];
    WK [label="W_K  (학습 행렬)", fillcolor="#ffe6cc", color="#d95f02"];
    WV [label="W_V  (학습 행렬)", fillcolor="#d9ead3", color="#1a9641"];

    Q [label="Q  Query\n'나는 무엇을 찾고 있는가'",
       fillcolor="#dae8fc", color="#4878a8", shape=ellipse];
    K [label="K  Key\n'나는 어떤 정보를 가졌는가 (색인)'",
       fillcolor="#ffe6cc", color="#d95f02", shape=ellipse];
    V [label="V  Value\n'실제로 전달할 내용'",
       fillcolor="#d9ead3", color="#1a9641", shape=ellipse];

    subgraph cluster_attn {
        label="다음 절 12.2 — 어텐션 연산";
        labelloc=n; color="#999999"; style="dashed,rounded";
        fontcolor="#666666"; fontsize=13; fontname="Noto Sans CJK KR";
        SCORE [label="Q · K^T\n(관련도 원점수)", fillcolor="#ffffff", shape=box];
        SOFT  [label="softmax\n(어텐션 가중치, 합이 1)", fillcolor="#ffffff", shape=box];
        OUT   [label="어텐션 출력\n(V의 가중합)", fillcolor="#e1d5e7", color="#9673a6"];
        SCORE -> SOFT -> OUT;
    }

    X -> WQ [label="곱하기"];  X -> WK [label="곱하기"];  X -> WV [label="곱하기"];
    WQ -> Q;  WK -> K;  WV -> V;
    Q -> SCORE [label=""];  K -> SCORE [label=""];
    V -> OUT [style="dashed", label=""];
}
