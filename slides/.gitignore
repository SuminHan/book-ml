# generated / transient
gen/logs/
gen/prompts/
gen/.scheduler.lock
gen/.scheduler.done
gen/dashboard.html
gen/STATUS.txt
# NOTE: leading slash matters. This ignores only the old shared generated
# cache at slides/figs/, which build_figs.sh regenerates from kor/src/images/.
# Without the slash it also matched every per-deck slides/kor/<deck>/figs/,
# silently dropping images that have no source anywhere else (pasted
# screenshots, photos).
/figs/
kor/*.aux
kor/*.log
kor/*.nav
kor/*.out
kor/*.snm
kor/*.toc
kor/*.vrb
kor/week01.pdf
kor/*.png
__pycache__/
