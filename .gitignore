# exam drafts/answer keys -- must not leak to students via the public repo
slides/kor/*/exams/

# weekly quiz drafts/answer keys -- same reasoning as exams above
slides/kor/*/quizzes/

# copyrighted reference PDFs (textbooks, etc.) kept locally for personal use only
/references/

# cq (local Qwen) orchestration pipeline working files -- not book content
tools/batch_prompts/
tools/batch_logs/

# mdbook copies kor/src/images/ref_<slug>.json (dashboard-only sidecar
# metadata, not linked from any page) into docs/ on every build
docs/kor/images/*.json
docs/eng/images/*.json
tools/retry_counts.json
tools/RUN_STATUS.md
tools/orchestrator.log
tools/chapter_opener.log
tools/citation.log
tools/reflib.log
tools/stanford.log
tools/progress_data.json
/dashboard.html
.playwright-mcp/

# scratch scripts/data cq leaves behind in the repo root while verifying
# numbers for a section (debug/verify/build_nb one-offs, saved npy/json/pkl
# intermediates) -- disposable, the real output already landed in
# kor/src/, notebooks/, kor/src/images/.
/.*.py
/.*.npy
/.*.json
/.*.pkl
/.*.txt
/tmp_*.py
/tmp_*.txt
MUJOCO_LOG.TXT
!/.mcp.json

__pycache__/
*.pyc
.ipynb_checkpoints/

# same scratch-script pattern, but the handful of runs that used tools/ as
# their cwd instead of the repo root -- tools/build_dashboard.py,
# chapter_opener_orchestrator.py, cq_run_once.py, dashboard_template.html,
# generate_progress_data.py, katex_inline_assets.html, orchestrator.py are
# the real pipeline and are intentionally NOT matched by these globs.
tools/tmp_*.py
tools/tmp_*.txt
tools/verify_*.py
tools/build_nb_*.py
tools/cq_nb_verify.py
tools/cq_test_prompt.txt
tools/launch_parallel_batch.py

# slide_review_server.py working files -- rendered page thumbnails (cache,
# regenerable from the PDFs), per-deck reviewer notes, the storyboard
# reorder/insert plan, and the applied-notes audit log (personal
# drafts/process trace, not book content)
/.review_cache/
slides/**/*.review.json
slides/**/*.review_log.jsonl
slides/**/*.plan.json
