digraph actor_critic {
    rankdir=LR;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="Actor-Critic: Actor(정책)와 Critic(가치)이 앞부분을 공유하고 마지막 출력층만 달리하는 구조. Critic의 V(s_t)가 G_t에서 빼져 어드밴티지 A_t가 만들어지고, 두 손실이 각각 파라미터를 갱신한다",
           labeljust=c, bgcolor="white", pad=0.3];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=10,
           penwidth=1.3, margin="0.18,0.1"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9, color="#495057", penwidth=1.5];

    # --- 입력 / 환경 ---
    S  [label="상태  s_t", fillcolor="#e7f1ff"];
    ENV [label="환경  env.step(a_t)\n-> r_t, s_{t+1}", fillcolor="#f8f9fa"];

    # --- 공유 층 (cluster) ---
    subgraph cluster_shared {
        label="공유 특성 층 (shared trunk)"; labeljust=l; fontsize=11;
        fontcolor="#343a40"; color="#adb5bd"; style="rounded,filled";
        fillcolor="#f8f9fa";
        node [fillcolor="#e7f1ff"];
        TRUNK [label="Linear(4,64) + ReLU\n공유 은닉층"];
    }

    # --- Actor 헤드 (cluster) ---
    subgraph cluster_actor {
        label="Actor 헤드  (정책)"; labeljust=l; fontsize=11;
        fontcolor="#343a40"; color="#9ec5fe"; style="rounded,filled";
        fillcolor="#f8fbff";
        node [fillcolor="#dbe9ff"];
        ACT [label="Linear(64,2)\nsoftmax -> pi(a|s_t)"];
    }

    # --- Critic 헤드 (cluster) ---
    subgraph cluster_critic {
        label="Critic 헤드  (가치)"; labeljust=l; fontsize=11;
        fontcolor="#343a40"; color="#d6b656"; style="rounded,filled";
        fillcolor="#fffdf5";
        node [fillcolor="#fff3bf"];
        CRIT [label="Linear(64,1)\nV(s_t)"];
    }

    # --- 어드밴티지 + 손실 ---
    RET [label="리턴  G_t\n(에피소드 누적 보상)", fillcolor="#fff3bf"];
    ADV [label="어드밴티지\nA_t = G_t - V(s_t)", fillcolor="#d3f9d8"];
    ALOSS [label="Actor 손실\n- sum log pi(a_t|s_t) * A_t", fillcolor="#ffe3e3"];
    CLOSS [label="Critic 손실\nTD(0):  (r_t + gamma V(s_{t+1}) - V(s_t))^2", fillcolor="#fff3bf"];
    OPT [label="Adam 갱신\n(파라미터 공유)", shape=ellipse, fillcolor="#e7f1ff"];

    # --- 데이터 흐름 ---
    S  -> TRUNK;
    TRUNK -> ACT;
    TRUNK -> CRIT;
    ACT -> ENV [label="a_t ~ pi(·|s_t) 샘플"];
    ENV -> RET [label="r_t"];
    ENV -> S  [style=dashed, label="s_{t+1} (다음 스텝 입력)"];
    CRIT -> ADV [label="V(s_t)"];
    RET  -> ADV [label="G_t"];
    ADV  -> ALOSS;
    CRIT -> CLOSS [label="V(s_t), V(s_{t+1})"];
    ENV  -> CLOSS [label="r_t", style=dashed];

    # --- 파라미터 갱신 루프 (점선) ---
    ALOSS -> OPT [style=dashed, color="#c92a2a"];
    CLOSS -> OPT [style=dashed, color="#c92a2a"];
    OPT -> TRUNK [style=dashed, color="#c92a2a", label="grad"];
    ACT -> ALOSS [style=bold, label="log pi(a_t|s_t)"];
}
