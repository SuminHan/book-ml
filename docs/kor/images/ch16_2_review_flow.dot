digraph review_flow {
    rankdir=TB;
    graph [fontname="Noto Sans CJK KR", labelloc=t,
           label="16.2 Peer-Review — '반박 가능한' 리뷰를 쓰는 과정 (신경망 RL 버전)",
           labeljust=c, bgcolor="white"];
    node  [fontname="Noto Sans CJK KR", shape=box, style="rounded,filled",
           fillcolor="white", fontcolor="#212529", fontsize=11,
           penwidth=1.3, margin="0.15,0.08"];
    edge  [fontname="Noto Sans CJK KR", fontsize=9.5, color="#495057", penwidth=1.5];

    A [label="다른 팀 발표 + 보고서 읽기\n(알고리즘·하이퍼파라미터·숫자·결론 파악)"];

    subgraph cluster_check {
        label="체크리스트를 항목별로 적용";
        labeljust=l; fontsize=12; fontcolor="#343a40";
        color="#adb5bd"; style="rounded,filled"; fillcolor="#f8f9fa";
        node [fillcolor="#e9ecef", fontsize=10];
        B1 [label="1. 환경 설명\n상태·행동·보상·주 지표·베이스라인"];
        B2 [label="2. 알고리즘 선택\n환경 특성(이산/연속, 희소 보상)에 맞는가"];
        B3 [label="3. 수식적 정당화\nCh9~15 개념이 관측 숫자와 일치하는가"];
        B4 [label="4. 결과의 정직성\n시드 ≥3, 불안정 구간이 숨기지 않고 있는가"];
        B5 [label="5. 탐험-활용 균형\nCh02 딜레마가 학습 곡선에 드러나는가"];
    }

    C [label="각 항목에 질문을 초안하기\n(답이 *새 계산·실험*이어야 함)", fillcolor="#e7f0fd"];
    D [shape=diamond, style="filled,rounded",
       label="Ch9~15의 개념(장·절)을 근거로 들고,\n답하려면 새 실험(시드 재실행·평가 프로토콜 변경·\n베이스라인 실측·스케일 비교)이 필요한가?",
       fillcolor="#fff8e1"];
    E [label="채택 — 반박 가능한 질문\n(예: '시드 2개를 더 돌리면 이동평균의\n편차가 얼마나 되나요? 알고리즘 간 차이가\n그것보다 큰가?' — Ch11.2)",
       fillcolor="#d1e7dd", fontcolor="#0f5132"];
    F [label="쓰기 다시 — 감상평은 리뷰가 아님\n('곡선이 올라가네요', '시드 몇 개 더 돌리면 좋겠네요')",
       fillcolor="#fdecea", fontcolor="#842029"];
    G [label="구체성 레벨로 채점\n1점 감상평 / 2점 일반 지적 / 3점 반박 가능한 질문",
       fillcolor="#d1e7dd", fontcolor="#0f5132"];

    A -> B1;
    B1 -> B2; B2 -> B3; B3 -> B4; B4 -> B5;
    B5 -> C;
    C -> D;
    D -> E [label="예"];
    D -> F [label="아니오"];
    F -> C [style=dashed, color="#c0392b", penwidth=1.8,
            label="Ch09.2(ε-greedy)·Ch11.3(GAE λ)·\nCh12.1(복합 오차) 등 개념을 근거로 다시 쓰기"];
    E -> G;
}
